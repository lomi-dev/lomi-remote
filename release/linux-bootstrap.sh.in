#!/bin/sh
set -eu
umask 077

BOOTSTRAP_ORIGIN=@@BOOTSTRAP_ORIGIN_SHELL@@
EXPECTED_PLATFORM=@@BOOTSTRAP_PLATFORM_SHELL@@
EXPECTED_TARGET=@@BOOTSTRAP_TARGET_SHELL@@
EXPECTED_VERSION=@@BOOTSTRAP_VERSION_SHELL@@
EXPECTED_ROOT_SHA256=@@BOOTSTRAP_ROOT_SHA256_SHELL@@
EXPECTED_KEY_SHA256=@@BOOTSTRAP_KEY_SHA256_SHELL@@
ARCHIVE_NAME=@@BOOTSTRAP_ARCHIVE_NAME_SHELL@@
ARCHIVE_SIZE=@@BOOTSTRAP_ARCHIVE_SIZE_SHELL@@
ARCHIVE_SHA256=@@BOOTSTRAP_ARCHIVE_SHA256_SHELL@@
ARCHIVE_MAX_BYTES=@@BOOTSTRAP_ARCHIVE_MAX_BYTES_SHELL@@
MANIFEST_NAME=@@BOOTSTRAP_MANIFEST_NAME_SHELL@@
MANIFEST_SIZE=@@BOOTSTRAP_MANIFEST_SIZE_SHELL@@
SIGNATURE_NAME=@@BOOTSTRAP_SIGNATURE_NAME_SHELL@@
PUBLIC_KEY_NAME=@@BOOTSTRAP_PUBLIC_KEY_NAME_SHELL@@

fail() {
    printf '%s\n' "Lomi Remote Linux bootstrap: $1" >&2
    exit 1
}

status() {
    printf '%s\n' "Lomi Remote: $1" >&2
}

case "$EXPECTED_PLATFORM" in
    linux-x86_64|linux-aarch64) ;;
    *) fail 'unsupported Linux target' ;;
esac
host_os=$(uname -s) || fail 'could not identify this operating system'
[ "$host_os" = Linux ] || fail 'this bootstrap is only for Linux'
host_arch=$(uname -m) || fail 'could not identify this machine architecture'
case "$EXPECTED_PLATFORM:$host_arch" in
    linux-x86_64:x86_64|linux-aarch64:aarch64) ;;
    *) fail 'release platform does not match this Linux machine' ;;
esac
lomi_expected_option=
for lomi_argument do
    case "$lomi_expected_option" in
        version)
            [ "$lomi_argument" = "$EXPECTED_VERSION" ] \
                || fail 'requested version differs from this authenticated bootstrap'
            lomi_expected_option=
            ;;
        install-dir)
            case "$lomi_argument" in /*) ;; *) fail 'install path must be absolute' ;; esac
            lomi_expected_option=
            ;;
        '')
            case "$lomi_argument" in
                --version) lomi_expected_option=version ;;
                --install-dir) lomi_expected_option=install-dir ;;
                install|uninstall|--no-path) ;;
                *) fail 'use install|uninstall [--version VERSION] [--install-dir ABSOLUTE_PATH] [--no-path]' ;;
            esac
            ;;
    esac
done
[ -z "$lomi_expected_option" ] || fail 'installer option is missing its value'

openssl_version=$(openssl version 2>/dev/null) || fail 'OpenSSL 3 is required'
case "$openssl_version" in OpenSSL\ 3.*) ;; *) fail 'OpenSSL 3 is required' ;; esac
if command -v unzip >/dev/null 2>&1; then
    archive_extractor=unzip
elif command -v python3 >/dev/null 2>&1; then
    archive_extractor=python3
else
    fail 'Linux archive extraction requires either unzip or python3; install unzip or Python 3 before retrying'
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/lomi-bootstrap.XXXXXXXX") \
    || fail 'could not create a private bootstrap directory'
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
mkdir "$work/extracted"

download_bounded() {
    url=$1
    destination=$2
    expected_size=$3
    show_progress=${4:-0}
    limit=$((expected_size + 1))
    (
        set +e
        if [ "$show_progress" -eq 1 ] && [ -t 2 ] && [ "${TERM:-}" != dumb ]; then
            curl --fail --show-error --progress-bar --proto '=https' --tlsv1.2 \
                --connect-timeout 20 --max-time 600 "$url"
        else
            curl --fail --silent --show-error --proto '=https' --tlsv1.2 \
                --connect-timeout 20 --max-time 600 "$url"
        fi
        curl_result=$?
        printf '%s\n' "$curl_result" > "$work/download-status"
    ) | head -c "$limit" > "$destination" \
        || fail 'could not write a bounded signed release download'
    IFS= read -r curl_result < "$work/download-status" \
        || fail 'could not read the signed release download status'
    [ "$curl_result" = 0 ] || fail 'signed release download failed'
    actual_size=$(LC_ALL=C wc -c < "$destination" | tr -d '[:space:]')
    [ "$actual_size" = "$expected_size" ] \
        || fail 'download size did not match the signed release'
}

fetch() {
    asset=$1
    destination=$2
    expected_size=$3
    show_progress=${4:-0}
    download_bounded "${BOOTSTRAP_ORIGIN}${asset}" "$destination" "$expected_size" "$show_progress"
}

status "Fetching Linux release metadata for v$EXPECTED_VERSION..."
fetch "$MANIFEST_NAME" "$work/manifest" "$MANIFEST_SIZE"
cat > "$work/expected-manifest" <<LOMI_BOOTSTRAP_MANIFEST
LOMI-LINUX-BOOTSTRAP-V1
platform=$EXPECTED_PLATFORM
target=$EXPECTED_TARGET
version=$EXPECTED_VERSION
public-tuf-root-sha256=$EXPECTED_ROOT_SHA256
archive=$ARCHIVE_NAME
archive-size=$ARCHIVE_SIZE
archive-sha256=$ARCHIVE_SHA256
LOMI_BOOTSTRAP_MANIFEST
cmp -s "$work/manifest" "$work/expected-manifest" \
    || fail 'release manifest does not match the pinned platform, target, version, or root'

fetch "$SIGNATURE_NAME" "$work/manifest.sig" 64
fetch "$PUBLIC_KEY_NAME" "$work/public.der" 44
actual_key_sha256=$(sha256sum "$work/public.der")
actual_key_sha256=${actual_key_sha256%% *}
[ "$actual_key_sha256" = "$EXPECTED_KEY_SHA256" ] \
    || fail 'bootstrap public key does not match the independently pinned digest'
openssl pkeyutl -verify -rawin -pubin -keyform DER \
    -inkey "$work/public.der" -in "$work/manifest" \
    -sigfile "$work/manifest.sig" >/dev/null 2>&1 \
    || fail 'release manifest signature is invalid'

case "$ARCHIVE_SIZE" in
    ''|0|0*|*[!0-9]*) fail 'invalid pinned archive size' ;;
esac
[ "${#ARCHIVE_SIZE}" -le 10 ] \
    || fail 'pinned archive exceeds the supported size limit'
[ "$ARCHIVE_SIZE" -le "$ARCHIVE_MAX_BYTES" ] \
    || fail 'pinned archive exceeds the supported size limit'
status "Downloading Lomi Remote v$EXPECTED_VERSION for $EXPECTED_PLATFORM..."
fetch "$ARCHIVE_NAME" "$work/archive.zip" "$ARCHIVE_SIZE" 1
status 'Verifying the signed Linux release archive...'
actual_archive_sha256=$(sha256sum "$work/archive.zip")
actual_archive_sha256=${actual_archive_sha256%% *}
[ "$actual_archive_sha256" = "$ARCHIVE_SHA256" ] \
    || fail 'release archive digest is invalid'

status 'Extracting the verified Linux release...'
if [ "$archive_extractor" = unzip ]; then
    unzip -tq "$work/archive.zip" >/dev/null \
        || fail 'release archive is not a valid ZIP file (unzip validation failed)'
    unzip -q "$work/archive.zip" -d "$work/extracted" \
        || fail 'release archive could not be extracted by unzip'
else
    python3 -I - "$work/archive.zip" "$work/extracted" <<'LOMI_BOOTSTRAP_PYTHON_ZIP'
import os
import stat
import sys
import zipfile

archive_path, destination = sys.argv[1:]


def reject(message):
    raise ValueError(message)


try:
    with zipfile.ZipFile(archive_path, "r") as archive:
        entries = archive.infolist()
        if len(entries) > 1000:
            reject("archive contains too many entries")

        recorded = {}
        total_size = 0
        for entry in entries:
            name = entry.filename
            is_directory = name.endswith("/")
            path = name[:-1] if is_directory else name
            if (not path or name.startswith("/") or "\\" in name
                    or ":" in path.split("/", 1)[0]):
                reject("archive contains an absolute or invalid path")
            parts = path.split("/")
            if any(part in ("", ".", "..") for part in parts):
                reject("archive contains an absolute or traversal path")

            mode = (entry.external_attr >> 16) & 0xFFFF
            file_type = stat.S_IFMT(mode) if entry.create_system == 3 else 0
            if file_type not in (0, stat.S_IFDIR, stat.S_IFREG):
                reject("archive contains a symlink or special file")
            if is_directory:
                if file_type == stat.S_IFREG or entry.file_size != 0:
                    reject("archive contains an invalid directory entry")
            elif file_type == stat.S_IFDIR:
                reject("archive contains an invalid file entry")

            if path in recorded:
                reject("archive contains duplicate entry names")
            recorded[path] = is_directory

            if not is_directory:
                if entry.file_size > 256 * 1024 * 1024:
                    reject("archive entry exceeds its size limit")
                total_size += entry.file_size
                if total_size > 1024 * 1024 * 1024:
                    reject("archive contents exceed their size limit")

        for path, is_directory in recorded.items():
            parts = path.split("/")
            for index in range(1, len(parts)):
                parent = "/".join(parts[:index])
                if parent in recorded and not recorded[parent]:
                    reject("archive file conflicts with a parent directory")
            if not is_directory and any(
                other.startswith(path + "/") for other in recorded
            ):
                reject("archive file conflicts with a child entry")

        if "install.sh" not in recorded or recorded["install.sh"]:
            reject("archive lacks install.sh")
        if "lomi-update-trust" not in recorded or recorded["lomi-update-trust"]:
            reject("archive lacks lomi-update-trust")

        os.makedirs(destination, mode=0o700, exist_ok=True)
        for entry in entries:
            path = entry.filename[:-1] if entry.filename.endswith("/") else entry.filename
            target = os.path.join(destination, *path.split("/"))
            if entry.filename.endswith("/"):
                os.makedirs(target, mode=0o755, exist_ok=True)
                continue

            parent = os.path.dirname(target)
            os.makedirs(parent, mode=0o755, exist_ok=True)
            copied = 0
            with archive.open(entry, "r") as source, open(target, "xb") as output:
                while True:
                    chunk = source.read(1024 * 1024)
                    if not chunk:
                        break
                    copied += len(chunk)
                    if copied > entry.file_size:
                        reject("archive entry exceeds its declared size")
                    output.write(chunk)
            if copied != entry.file_size:
                reject("archive entry size does not match its declaration")

            mode = (entry.external_attr >> 16) & 0xFFFF
            permissions = mode & 0o777 if entry.create_system == 3 else 0o644
            if not permissions:
                permissions = 0o644
            os.chmod(target, permissions)
except Exception as error:
    print("Lomi Remote Linux bootstrap: Python ZIP extraction failed: " + str(error), file=sys.stderr)
    sys.exit(1)
LOMI_BOOTSTRAP_PYTHON_ZIP
fi
[ -f "$work/extracted/install.sh" ] \
    || fail 'authenticated release archive lacks install.sh'
[ -f "$work/extracted/lomi-update-trust" ] \
    || fail 'authenticated release archive lacks lomi-update-trust'
[ -x "$work/extracted/install.sh" ] \
    || fail 'authenticated release archive install.sh is not executable'
[ -x "$work/extracted/lomi-update-trust" ] \
    || fail 'authenticated release archive lomi-update-trust is not executable'
status 'Starting the authenticated Linux installer...'
/bin/sh "$work/extracted/install.sh" "$@"
