[Unit]
Description=Lomi synthetic persistent PTY qualification fixture

[Service]
Type=simple
ExecStart=/usr/local/libexec/lomi-service-fixture owner /var/lib/lomi-service-fixture/state
Restart=on-failure
RestartSec=1
KillMode=control-group
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
Environment=HOME=/var/lib/lomi-service-fixture
Environment=PATH=/usr/bin:/bin
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
