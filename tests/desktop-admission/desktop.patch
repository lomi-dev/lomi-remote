+
+#[cfg(feature = "e0-admission-probe")]
+pub(crate) fn check_native(root: &Path) -> Result<(), String> {
+    let registry = shared();
+    let state = registry.lock().map_err(|_| UNAVAILABLE)?;
+    let active = state
+        .leases
+        .values()
+        .find(|a| a.root.path == root)
+        .ok_or(STOP_RUN)?;
+    active.root.check()?;
+    active.remote.check()
+}
+#[cfg(feature = "e0-admission-probe")]
+impl Lease {
+    pub(crate) fn probe_token(&self) -> &str {
+        self.remote.token()
+    }
+}
+
+#[cfg(feature = "e0-admission-probe")]
+impl WriteAdmission {
+    /// Caller proves this scope performs only synchronous in-process I/O.
+    pub(crate) fn known_in_process(mut self) -> Self {
+        for admission in &mut self._remote {
+            admission.known_in_process();
+        }
+        self
+    }
+}
