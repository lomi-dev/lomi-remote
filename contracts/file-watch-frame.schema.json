{
  "$defs": {
    "BoundedList": {
      "items": {
        "$ref": "#/$defs/EntryId"
      },
      "maxItems": 200,
      "type": "array"
    },
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "EntryId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "EventCursor": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "FileWatchAck": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/WorkspaceContext"
        },
        "cursor": {
          "$ref": "#/$defs/EventCursor"
        },
        "subscriptionId": {
          "$ref": "#/$defs/SubscriptionId"
        },
        "throughSeq": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "context",
        "subscriptionId",
        "throughSeq",
        "cursor"
      ],
      "type": "object"
    },
    "FileWatchEvent": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/WorkspaceContext"
        },
        "cursor": {
          "$ref": "#/$defs/EventCursor"
        },
        "invalidation": {
          "$ref": "#/$defs/FilesInvalidated"
        },
        "subscriptionId": {
          "$ref": "#/$defs/SubscriptionId"
        },
        "watchSeq": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "context",
        "subscriptionId",
        "watchSeq",
        "cursor",
        "invalidation"
      ],
      "type": "object"
    },
    "FilesInvalidated": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "$ref": "#/$defs/BoundedList"
        },
        "overflow": {
          "type": "boolean"
        }
      },
      "required": [
        "entries",
        "overflow"
      ],
      "type": "object"
    },
    "ResyncReason": {
      "enum": [
        "gap",
        "stale_cursor",
        "workspace_epoch_changed",
        "runtime_changed",
        "session_epoch_changed",
        "profile_changed",
        "subscriber_overflow",
        "watch_overflow",
        "snapshot_invalid",
        "assembly_timeout"
      ],
      "type": "string"
    },
    "RuntimeId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SubscriptionId": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string",
      "x-lomi-maxUtf8Bytes": 128
    },
    "WorkspaceContext": {
      "additionalProperties": false,
      "properties": {
        "grantRevision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "hostAccessEpoch": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeId": {
          "$ref": "#/$defs/RuntimeId"
        },
        "workspaceEpoch": {
          "$ref": "#/$defs/WorkspaceEpoch"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "workspaceEpoch",
        "runtimeId",
        "runtimeGeneration",
        "hostAccessEpoch",
        "grantRevision"
      ],
      "type": "object"
    },
    "WorkspaceEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceResync": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/WorkspaceContext"
        },
        "reason": {
          "$ref": "#/$defs/ResyncReason"
        },
        "subscriptionId": {
          "$ref": "#/$defs/SubscriptionId"
        }
      },
      "required": [
        "context",
        "subscriptionId",
        "reason"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/FileWatchEvent"
        },
        "type": {
          "const": "invalidated",
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/FileWatchAck"
        },
        "type": {
          "const": "ack",
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "data": {
          "$ref": "#/$defs/WorkspaceResync"
        },
        "type": {
          "const": "resyncRequired",
          "type": "string"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "type": "object"
    }
  ],
  "title": "FileWatchFrame"
}
