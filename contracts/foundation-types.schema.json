          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "Method": {
      "enum": [
        "workspace.get",
        "workspace.capabilities",
        "workspace.subscribe",
        "terminal.create",
        "terminal.split",
        "terminal.rename",
        "terminal.move",
        "terminal.close",
        "terminal.restart",
        "terminal.attach",
        "terminal.snapshot",
        "terminal.ack",
        "terminal.claim",
        "terminal.renew",
        "terminal.release",
        "terminal.input",
        "terminal.resize",
        "files.list",
        "files.stat",
        "files.read",
        "files.searchNames",
        "files.watch",
        "files.create",
        "files.mkdir",
        "files.rename",
        "files.remove",
        "git.repositories",
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.stage",
        "git.unstage",
        "git.commit",
        "git.fetch",
        "git.push",
        "git.pull",
