{
  "$defs": {
    "CanonicalCryptoCborHex": {
      "maxLength": 16384,
      "minLength": 1,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "EnrollmentProof": {
      "additionalProperties": false,
      "properties": {
        "canonicalCbor": {
          "$ref": "#/$defs/CanonicalCryptoCborHex"
        },
        "signature": {
          "$ref": "#/$defs/SignatureHex"
        }
      },
      "required": [
        "canonicalCbor",
        "signature"
      ],
      "type": "object"
    },
    "HostKeyCommitmentHex": {
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "PublicClientId": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "SignatureHex": {
      "maxLength": 128,
      "minLength": 128,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "clientId": {
      "$ref": "#/$defs/PublicClientId"
    },
    "keyCommitment": {
      "$ref": "#/$defs/HostKeyCommitmentHex"
    },
    "proof": {
      "$ref": "#/$defs/EnrollmentProof"
    }
  },
  "required": [
    "clientId",
    "keyCommitment",
    "proof"
  ],
  "title": "EnrollmentInitiateParams",
  "type": "object"
}
