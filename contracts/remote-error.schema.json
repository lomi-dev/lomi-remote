{
  "$defs": {
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "Effect": {
      "enum": [
        "none",
        "committed",
        "partial",
        "unknown"
      ],
      "type": "string"
    },
    "EmptyErrorDetails": {
      "additionalProperties": false,
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_ARGUMENT",
        "AUTH_REQUIRED",
        "SCOPE_DENIED",
        "WORKSPACE_UNSHARED",
        "REPOSITORY_EXECUTION_REQUIRED",
        "PROTECTED_PATH",
        "RESOURCE_NOT_FOUND",
        "OPERATION_NOT_FOUND",
        "STALE_EPOCH",
        "REVISION_CONFLICT",
        "FILE_CHANGED",
        "IDEMPOTENCY_CONFLICT",
        "HOST_BUSY",
        "CONTROL_REQUIRED",
        "CONTROL_REVOKED",
        "SESSION_EXITED",
        "RESYNC_REQUIRED",
        "DIRECTORY_NOT_EMPTY",
        "CREDENTIALS_REQUIRED",
        "GIT_IDENTITY_REQUIRED",
        "UNSUPPORTED_CAPABILITY",
        "OUTCOME_UNKNOWN",
        "OPERATION_EXPIRED",
        "UPDATE_REQUIRED",
        "RESOURCE_EXHAUSTED",
        "FRESHNESS_REQUIRED",
        "SERVICE_UNAVAILABLE",
        "DEADLINE_EXCEEDED"
      ],
      "type": "string"
    },
    "ErrorDetails": {
      "anyOf": [
        {
          "$ref": "#/$defs/RevisionErrorDetails"
        },
        {
          "$ref": "#/$defs/EmptyErrorDetails"
        }
      ]
    },
    "OperationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "OperationLookup": {
      "additionalProperties": false,
      "description": "Status lookup route within the authenticated workspace channel. Never a URL.",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/OperationId"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "operationId"
      ],
      "type": "object"
    },
    "RevisionErrorDetails": {
      "additionalProperties": false,
      "properties": {
        "actualRevision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "expectedRevision": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "expectedRevision",
        "actualRevision"
      ],
      "type": "object"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "details": {
      "$ref": "#/$defs/ErrorDetails"
    },
    "effect": {
      "$ref": "#/$defs/Effect"
    },
    "message": {
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationLookup"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "message",
    "retryable",
    "effect",
    "details"
  ],
  "title": "RemoteError",
  "type": "object"
}
