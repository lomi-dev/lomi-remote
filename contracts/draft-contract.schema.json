{
  "$defs": {
    "ApplicationMajor": {
      "const": 2,
      "type": "integer"
    },
    "Capability": {
      "enum": [
        "workspace.read",
        "terminal.observe",
        "terminal.control",
        "terminal.manage",
        "files.read",
        "files.write",
        "git.read",
        "git.write",
        "git.network",
        "git.execute"
      ],
      "type": "string"
    },
    "CapabilitySet": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array"
    },
    "ChannelPurpose": {
      "enum": [
        "workspace",
        "terminal"
      ],
      "type": "string"
    },
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "DraftCommand": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "files.create",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/FileCreate"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "files.remove",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/FileRemove"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "terminal.create",
              "type": "string"
            },
            "params": {
              "$ref": "#/$defs/TerminalCreate"
            }
          },
          "required": [
            "method",
            "params"
          ],
          "type": "object"
        }
      ]
    },
    "EntryId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "FileCreate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "parentEntryId": {
          "$ref": "#/$defs/EntryId"
        },
        "parentRevision": {
          "$ref": "#/$defs/FileRevision"
        }
      },
      "required": [
        "parentEntryId",
        "parentRevision",
        "name"
      ],
      "type": "object"
    },
    "FileRemove": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "type": "boolean"
        },
        "entryId": {
          "$ref": "#/$defs/EntryId"
        },
        "fileRevision": {
          "$ref": "#/$defs/FileRevision"
        },
        "parentRevision": {
          "$ref": "#/$defs/FileRevision"
        }
      },
      "required": [
        "entryId",
        "fileRevision",
        "parentRevision",
        "confirmed"
      ],
      "type": "object"
    },
    "FileRevision": {
      "maxLength": 256,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "GrantContextVersion": {
      "const": 3,
      "type": "integer"
    },
    "LocalIpcMajor": {
      "const": 1,
      "type": "integer"
    },
    "LocalIpcVersion": {
      "additionalProperties": false,
      "properties": {
        "major": {
          "$ref": "#/$defs/LocalIpcMajor"
        },
        "minor": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "MutationContext": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/WorkspaceContext"
        },
        "expectedRevision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "operationId": {
          "$ref": "#/$defs/OperationId"
        }
      },
      "required": [
        "operationId",
        "context",
        "expectedRevision"
      ],
      "type": "object"
    },
    "OperationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "PaneId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RemoteApiMajor": {
      "const": 2,
      "type": "integer"
    },
    "RuntimeId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SessionEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "TerminalContext": {
      "additionalProperties": false,
      "properties": {
        "paneId": {
          "$ref": "#/$defs/PaneId"
        },
        "profile": {
          "$ref": "#/$defs/TerminalProfile"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/SessionEpoch"
        },
        "sessionId": {
          "$ref": "#/$defs/TerminalSessionId"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceContext"
        }
      },
      "required": [
        "workspace",
        "paneId",
        "sessionId",
        "sessionEpoch",
        "profile"
      ],
      "type": "object"
    },
    "TerminalCreate": {
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string"
        },
        "tabName": {
          "type": "string"
        }
      },
      "required": [
        "tabName",
        "profileId"
      ],
      "type": "object"
    },
    "TerminalProfile": {
      "enum": [
        "lomi-rust-grid-v1-experimental"
      ],
      "type": "string"
    },
    "TerminalSessionId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "VersionAxes": {
      "additionalProperties": false,
      "properties": {
        "applicationMajor": {
          "$ref": "#/$defs/ApplicationMajor"
        },
        "grantContextVersion": {
          "$ref": "#/$defs/GrantContextVersion"
        },
        "localIpc": {
          "$ref": "#/$defs/LocalIpcVersion"
        },
        "remoteApiMajor": {
          "$ref": "#/$defs/RemoteApiMajor"
        },
        "terminalProfile": {
          "$ref": "#/$defs/TerminalProfile"
        }
      },
      "required": [
        "remoteApiMajor",
        "applicationMajor",
        "grantContextVersion",
        "localIpc",
        "terminalProfile"
      ],
      "type": "object"
    },
    "WorkspaceContext": {
      "additionalProperties": false,
      "properties": {
        "grantRevision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "hostAccessEpoch": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeId": {
          "$ref": "#/$defs/RuntimeId"
        },
        "workspaceEpoch": {
          "$ref": "#/$defs/WorkspaceEpoch"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "workspaceEpoch",
        "runtimeId",
        "runtimeGeneration",
        "hostAccessEpoch",
        "grantRevision"
      ],
      "type": "object"
    },
    "WorkspaceEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/CapabilitySet"
    },
    "command": {
      "$ref": "#/$defs/DraftCommand"
    },
    "mutation": {
      "$ref": "#/$defs/MutationContext"
    },
    "purpose": {
      "$ref": "#/$defs/ChannelPurpose"
    },
    "terminal": {
      "anyOf": [
        {
          "$ref": "#/$defs/TerminalContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "versions": {
      "$ref": "#/$defs/VersionAxes"
    }
  },
  "required": [
    "versions",
    "capabilities",
    "purpose",
    "mutation",
    "command"
  ],
  "title": "DraftContract",
  "type": "object"
}
