{
  "$defs": {
    "AccountId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "AccountSessionId": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "CanonicalCryptoCborHex": {
      "maxLength": 16384,
      "minLength": 1,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "CommitmentHostRole": {
      "enum": [
        "host"
      ],
      "type": "string"
    },
    "CommitmentSignature": {
      "items": {
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 64,
      "minItems": 64,
      "type": "array"
    },
    "ConsumerAuthorizationContext": {
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "$ref": "#/$defs/AccountId"
        },
        "accountSessionId": {
          "$ref": "#/$defs/AccountSessionId"
        },
        "canManageAccount": {
          "type": "boolean"
        },
        "class": {
          "$ref": "#/$defs/ConsumerClass"
        },
        "consumerAuthorizationId": {
          "$ref": "#/$defs/ConsumerAuthorizationId"
        },
        "expiresAt": {
          "$ref": "#/$defs/DecimalU64"
        }
      },
      "required": [
        "accountId",
        "consumerAuthorizationId",
        "accountSessionId",
        "class",
        "expiresAt",
        "canManageAccount"
      ],
      "type": "object"
    },
    "ConsumerAuthorizationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ConsumerClass": {
      "enum": [
        "web",
        "desktop",
        "mobile"
      ],
      "type": "string"
    },
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "EnrollmentProof": {
      "additionalProperties": false,
      "properties": {
        "canonicalCbor": {
          "$ref": "#/$defs/CanonicalCryptoCborHex"
        },
        "signature": {
          "$ref": "#/$defs/SignatureHex"
        }
      },
      "required": [
        "canonicalCbor",
        "signature"
      ],
      "type": "object"
    },
    "HostId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "HostKeyCommitmentDescriptor": {
      "additionalProperties": false,
      "properties": {
        "channelKey": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "hostId": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "minItems": 16,
          "type": "array"
        },
        "identityKey": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "keyVersion": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mailboxKey": {
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/CommitmentHostRole"
        },
        "version": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "hostId",
        "role",
        "keyVersion",
        "identityKey",
        "channelKey",
        "mailboxKey"
      ],
      "type": "object"
    },
    "HostKeyCommitmentHex": {
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "IdentityFingerprintHex": {
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "InventoryHost": {
      "additionalProperties": false,
      "properties": {
        "hostId": {
          "$ref": "#/$defs/HostId"
        },
        "identity": {
          "$ref": "#/$defs/EnrollmentProof"
        },
        "identityFingerprint": {
          "$ref": "#/$defs/IdentityFingerprintHex"
        },
        "initialCommitment": {
          "$ref": "#/$defs/HostKeyCommitmentHex"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeBinding"
        },
        "signedCommitment": {
          "$ref": "#/$defs/SignedHostKeyCommitmentWire"
        },
        "status": {
          "$ref": "#/$defs/InventoryStatus"
        },
        "workspaces": {
          "$ref": "#/$defs/PublicationWorkspaces"
        }
      },
      "required": [
        "hostId",
        "identity",
        "identityFingerprint",
        "signedCommitment",
        "initialCommitment",
        "runtime",
        "status",
        "workspaces"
      ],
      "type": "object"
    },
    "InventoryHosts": {
      "items": {
        "$ref": "#/$defs/InventoryHost"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "InventoryStatus": {
      "enum": [
        "online",
        "offline",
        "publishing"
      ],
      "type": "string"
    },
    "PaneId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "PublicationTerminals": {
      "items": {
        "$ref": "#/$defs/PublishedTerminal"
      },
      "maxItems": 4096,
      "type": "array",
      "uniqueItems": true
    },
    "PublicationWorkspaces": {
      "items": {
        "$ref": "#/$defs/PublishedWorkspace"
      },
      "maxItems": 256,
      "type": "array",
      "uniqueItems": true
    },
    "PublishedTerminal": {
      "additionalProperties": false,
      "properties": {
        "paneId": {
          "$ref": "#/$defs/PaneId"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/SessionEpoch"
        },
        "sessionId": {
          "$ref": "#/$defs/TerminalSessionId"
        }
      },
      "required": [
        "paneId",
        "sessionId",
        "sessionEpoch"
      ],
      "type": "object"
    },
    "PublishedWorkspace": {
      "additionalProperties": false,
      "properties": {
        "terminals": {
          "$ref": "#/$defs/PublicationTerminals"
        },
        "workspaceEpoch": {
          "$ref": "#/$defs/WorkspaceEpoch"
        },
        "workspaceId": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspaceId",
        "workspaceEpoch",
        "terminals"
      ],
      "type": "object"
    },
    "RuntimeBinding": {
      "additionalProperties": false,
      "properties": {
        "hostAccessEpoch": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeId": {
          "$ref": "#/$defs/RuntimeId"
        }
      },
      "required": [
        "runtimeId",
        "runtimeGeneration",
        "hostAccessEpoch"
      ],
      "type": "object"
    },
    "RuntimeId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SessionEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SignatureHex": {
      "maxLength": 128,
      "minLength": 128,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "SignedHostKeyCommitmentWire": {
      "additionalProperties": false,
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/HostKeyCommitmentDescriptor"
        },
        "signature": {
          "$ref": "#/$defs/CommitmentSignature"
        }
      },
      "required": [
        "descriptor",
        "signature"
      ],
      "type": "object"
    },
    "TerminalSessionId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization": {
      "$ref": "#/$defs/ConsumerAuthorizationContext"
    },
    "hosts": {
      "$ref": "#/$defs/InventoryHosts"
    }
  },
  "required": [
    "authorization",
    "hosts"
  ],
  "title": "InventoryResult",
  "type": "object"
}
