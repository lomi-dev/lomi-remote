{
  "$defs": {
    "ApplicationMajor": {
      "const": 2,
      "type": "integer"
    },
    "BoundedList": {
      "items": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 16384,
      "type": "array"
    },
    "BoundedList2": {
      "items": {
        "$ref": "#/$defs/GitStagePath"
      },
      "maxItems": 200,
      "type": "array"
    },
    "BoundedList3": {
      "items": {
        "$ref": "#/$defs/EntryId"
      },
      "maxItems": 200,
      "type": "array"
    },
    "CommitMessage": {
      "maxLength": 16384,
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]"
      },
      "type": "string",
      "x-lomi-maxUtf8Bytes": 16384
    },
    "Confirmed": {
      "enum": [
        "confirmed"
      ],
      "type": "string"
    },
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "DestinationState": {
      "enum": [
        "absent"
      ],
      "type": "string"
    },
    "DiffView": {
      "enum": [
        "index",
        "worktree"
      ],
      "type": "string"
    },
    "DisplayText": {
      "maxLength": 4096,
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]"
      },
      "type": "string",
      "x-lomi-maxUtf8Bytes": 4096
    },
    "EntryId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "EntryName": {
      "maxLength": 255,
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "[/\\\\\\u0000-\\u001F\\u007F-\\u009F]"
          },
          {
            "enum": [
              ".",
              ".."
            ]
          }
        ]
      },
      "type": "string",
      "x-lomi-maxUtf8Bytes": 255
    },
    "EventCursor": {
      "maxLength": 1024,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
