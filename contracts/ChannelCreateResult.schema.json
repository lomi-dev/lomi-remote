{
  "$defs": {
    "AccountSessionId": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "CanonicalCryptoCborHex": {
      "maxLength": 16384,
      "minLength": 1,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "ChannelAdmissionInputs": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/CurrentAuthorityBinding"
        },
        "expectedContext": {
          "$ref": "#/$defs/CanonicalCryptoCborHex"
        },
        "expectedContextJson": {
          "additionalProperties": true,
          "type": "object"
        },
        "grant": {
          "$ref": "#/$defs/SignedGrantWire"
        },
        "identities": {
          "$ref": "#/$defs/PeerIdentities"
        }
      },
      "required": [
        "expectedContext",
        "expectedContextJson",
        "grant",
        "identities",
        "authority"
      ],
      "type": "object"
    },
    "ChannelId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ChannelResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "channelId": {
              "$ref": "#/$defs/ChannelId"
            },
            "inputs": {
              "$ref": "#/$defs/ChannelAdmissionInputs"
            },
            "status": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "status",
            "channelId",
            "inputs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "admission": {
              "$ref": "#/$defs/SignedChannelAdmissionWire"
            },
            "channelId": {
              "$ref": "#/$defs/ChannelId"
            },
            "inputs": {
              "$ref": "#/$defs/ChannelAdmissionInputs"
            },
            "status": {
              "const": "admitted",
              "type": "string"
            }
          },
          "required": [
            "status",
            "channelId",
            "inputs",
            "admission"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "channelId": {
              "$ref": "#/$defs/ChannelId"
            },
            "status": {
              "const": "expired",
              "type": "string"
            }
          },
          "required": [
            "status",
            "channelId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "channelId": {
              "$ref": "#/$defs/ChannelId"
            },
            "status": {
              "const": "closed",
              "type": "string"
            }
          },
          "required": [
            "status",
            "channelId"
          ],
          "type": "object"
        }
      ]
    },
    "ChannelTerminalMembership": {
      "additionalProperties": false,
      "properties": {
        "paneId": {
          "$ref": "#/$defs/PaneId"
        },
        "sessionEpoch": {
          "$ref": "#/$defs/SessionEpoch"
        },
        "sessionId": {
          "$ref": "#/$defs/TerminalSessionId"
        },
        "terminalProfile": {
          "$ref": "#/$defs/TerminalProfile"
        }
      },
      "required": [
        "paneId",
        "sessionId",
        "sessionEpoch",
        "terminalProfile"
      ],
      "type": "object"
    },
    "ConsumerAuthorizationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "CurrentAuthorityBinding": {
      "additionalProperties": false,
      "properties": {
        "accessEpoch": {
          "$ref": "#/$defs/DecimalU64"
        },
        "accountSessionId": {
          "$ref": "#/$defs/AccountSessionId"
        },
        "consumerAuthorizationId": {
          "$ref": "#/$defs/ConsumerAuthorizationId"
        },
        "grantRevision": {
          "$ref": "#/$defs/DecimalU64"
        },
        "hostAuthorizationId": {
          "$ref": "#/$defs/HostAuthorizationId"
        },
        "runtimeGeneration": {
          "$ref": "#/$defs/DecimalU64"
        },
        "runtimeId": {
          "$ref": "#/$defs/RuntimeId"
        },
        "terminalMembership": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelTerminalMembership"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceEpoch": {
          "$ref": "#/$defs/WorkspaceEpoch"
        }
      },
      "required": [
        "hostAuthorizationId",
        "consumerAuthorizationId",
        "accountSessionId",
        "accessEpoch",
        "grantRevision",
        "workspaceEpoch",
        "runtimeId",
        "runtimeGeneration"
      ],
      "type": "object"
    },
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "EnrollmentProof": {
      "additionalProperties": false,
      "properties": {
        "canonicalCbor": {
          "$ref": "#/$defs/CanonicalCryptoCborHex"
        },
        "signature": {
          "$ref": "#/$defs/SignatureHex"
        }
      },
      "required": [
        "canonicalCbor",
        "signature"
      ],
      "type": "object"
    },
    "HostAuthorizationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "IdentityFingerprintHex": {
      "maxLength": 64,
      "minLength": 64,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "PaneId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "PeerIdentities": {
      "additionalProperties": false,
      "properties": {
        "consumer": {
          "$ref": "#/$defs/EnrollmentProof"
        },
        "consumerFingerprint": {
          "$ref": "#/$defs/IdentityFingerprintHex"
        },
        "host": {
          "$ref": "#/$defs/EnrollmentProof"
        },
        "hostFingerprint": {
          "$ref": "#/$defs/IdentityFingerprintHex"
        }
      },
      "required": [
        "host",
        "consumer",
        "hostFingerprint",
        "consumerFingerprint"
      ],
      "type": "object"
    },
    "RuntimeId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SessionEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SignatureHex": {
      "maxLength": 128,
      "minLength": 128,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    },
    "SignedChannelAdmissionWire": {
      "additionalProperties": false,
      "properties": {
        "canonicalCbor": {
          "$ref": "#/$defs/CanonicalCryptoCborHex"
        },
        "signature": {
          "$ref": "#/$defs/SignatureHex"
        }
      },
      "required": [
        "canonicalCbor",
        "signature"
      ],
      "type": "object"
    },
    "SignedGrantWire": {
      "additionalProperties": false,
      "properties": {
        "canonicalCbor": {
          "$ref": "#/$defs/CanonicalCryptoCborHex"
        },
        "signature": {
          "$ref": "#/$defs/SignatureHex"
        }
      },
      "required": [
        "canonicalCbor",
        "signature"
      ],
      "type": "object"
    },
    "TerminalProfile": {
      "enum": [
        "lomi-rust-grid-v1-experimental"
      ],
      "type": "string"
    },
    "TerminalSessionId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "channel": {
      "$ref": "#/$defs/ChannelResult"
    }
  },
  "required": [
    "channel"
  ],
  "title": "ChannelCreateResult",
  "type": "object"
}
