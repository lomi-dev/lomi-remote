{
  "$defs": {
    "BoundedList": {
      "items": {
        "$ref": "#/$defs/ResumeEntry"
      },
      "maxItems": 64,
      "type": "array"
    },
    "BoundedList2": {
      "items": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 4096,
      "type": "array"
    },
    "DeviceKind": {
      "enum": [
        "web",
        "mobile",
        "desktop"
      ],
      "type": "string"
    },
    "DeviceName": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F]"
      },
      "type": "string",
      "x-lomi-maxUtf8Bytes": 64
    },
    "ResumeEntry": {
      "properties": {
        "cursor": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/StreamKind"
        }
      },
      "required": [
        "kind",
        "cursor"
      ],
      "type": "object"
    },
    "StreamKind": {
      "description": "Declaration order equals the OPEN kind code and the postcard variant index.",
      "enum": [
        "rpc",
        "directory",
        "terminal",
        "chat",
        "files.watch",
        "transfer",
        "media"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "authEpoch": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "deviceBundle": {
      "$ref": "#/$defs/BoundedList2",
      "description": "Opaque signed device bundle; verified elsewhere."
    },
    "deviceKind": {
      "$ref": "#/$defs/DeviceKind"
    },
    "deviceName": {
      "$ref": "#/$defs/DeviceName"
    },
    "hostAccessEpoch": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "resume": {
      "$ref": "#/$defs/BoundedList"
    },
    "runtimeGeneration": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "sendDirectory": {
      "type": "boolean"
    }
  },
  "required": [
    "deviceName",
    "deviceKind",
    "authEpoch",
    "hostAccessEpoch",
    "runtimeGeneration",
    "resume",
    "sendDirectory",
    "deviceBundle"
  ],
  "title": "Hello",
  "type": "object"
}
