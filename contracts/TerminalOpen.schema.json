{
  "$defs": {
    "PaneId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SessionEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "TerminalDimension": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "afterSeq": {
