    },
    "sessionEpoch": {
      "$ref": "#/$defs/SessionEpoch"
    },
    "workspaceId": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "workspaceId",
    "paneId",
    "sessionEpoch",
    "cols",
    "rows"
  ],
  "title": "TerminalOpen",
  "type": "object"
}
