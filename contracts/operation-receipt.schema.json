{
  "$defs": {
    "Capability": {
      "enum": [
        "workspace.read",
        "terminal.observe",
        "terminal.control",
        "terminal.manage",
        "files.read",
        "files.write",
        "git.read",
        "git.write",
        "git.network",
        "git.execute"
      ],
      "type": "string"
    },
    "CapabilitySet": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array"
    },
    "ConsumerAuthorizationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "DecimalU64": {
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      },
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|1844674407370955[0-0][0-9]{3}|18446744073709551[0-5][0-9]{2}|184467440737095516[0-0][0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)$",
      "type": "string"
    },
    "Effect": {
      "enum": [
        "none",
        "committed",
        "partial",
        "unknown"
      ],
      "type": "string"
    },
    "EntryId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "FileRevision": {
      "maxLength": 256,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "Method": {
      "enum": [
        "workspace.get",
        "workspace.capabilities",
        "workspace.subscribe",
        "terminal.create",
        "terminal.split",
        "terminal.rename",
        "terminal.move",
        "terminal.close",
        "terminal.restart",
        "terminal.attach",
        "terminal.snapshot",
        "terminal.ack",
        "terminal.claim",
        "terminal.renew",
        "terminal.release",
        "terminal.input",
        "terminal.resize",
        "files.list",
        "files.stat",
        "files.read",
        "files.searchNames",
        "files.watch",
        "files.create",
        "files.mkdir",
        "files.rename",
        "files.remove",
        "git.repositories",
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.stage",
        "git.unstage",
        "git.commit",
        "git.fetch",
        "git.push",
        "git.pull",
        "operation.status",
        "operation.cancel"
      ],
      "type": "string"
    },
    "OperationId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "OperationParameterHash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "OperationResult": {
      "description": "Only identifiers/revisions, no names, paths, commands or cached plaintext.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "domainRevision": {
              "$ref": "#/$defs/DecimalU64"
            },
            "kind": {
              "const": "domain",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "domainRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "domainRevision": {
              "$ref": "#/$defs/DecimalU64"
            },
            "kind": {
              "const": "terminal",
              "type": "string"
            },
            "paneId": {
              "$ref": "#/$defs/PaneId"
            },
            "sessionEpoch": {
              "$ref": "#/$defs/SessionEpoch"
            },
            "sessionId": {
              "$ref": "#/$defs/TerminalSessionId"
            }
          },
          "required": [
            "kind",
            "domainRevision",
            "paneId",
            "sessionId",
            "sessionEpoch"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entryId": {
              "$ref": "#/$defs/EntryId"
            },
            "fileRevision": {
              "$ref": "#/$defs/FileRevision"
            },
            "kind": {
              "const": "file",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "entryId",
            "fileRevision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git",
              "type": "string"
            },
            "repoStateToken": {
              "$ref": "#/$defs/RepoStateToken"
            }
          },
          "required": [
            "kind",
            "repoStateToken"
          ],
          "type": "object"
        }
      ]
    },
    "OperationState": {
      "enum": [
        "accepted",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "outcome_unknown"
      ],
      "type": "string"
    },
    "PaneId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RepoStateToken": {
      "maxLength": 256,
      "minLength": 1,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      },
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "SessionEpoch": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "TerminalSessionId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "WorkspaceId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Validated receipt DTO, not proof of persistence, admission, authority or fencing.\nA consumer must authenticate current rights and row binding before disclosure.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/ConsumerAuthorizationId"
    },
    "actualRights": {
      "$ref": "#/$defs/CapabilitySet"
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "effect": {
      "$ref": "#/$defs/Effect"
    },
    "operationId": {
      "$ref": "#/$defs/OperationId"
    },
    "originalMethod": {
      "$ref": "#/$defs/Method"
    },
    "parameterHash": {
      "$ref": "#/$defs/OperationParameterHash"
    },
    "repositoryExecution": {
      "type": "boolean"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "$ref": "#/$defs/OperationState"
    },
    "workspaceId": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "operationId",
    "actor",
    "workspaceId",
    "originalMethod",
    "actualRights",
    "repositoryExecution",
    "parameterHash",
    "state",
    "cancelRequested",
    "effect"
  ],
  "title": "OperationReceipt",
  "type": "object"
}
