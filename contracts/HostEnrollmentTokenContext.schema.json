{
  "$defs": {
    "AccountId": {
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "CanonicalCryptoCborHex": {
      "maxLength": 16384,
      "minLength": 1,
      "not": {
        "pattern": "[^0-9a-f]"
      },
      "pattern": "^([0-9a-f]{2})+$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "$ref": "#/$defs/AccountId"
    },
    "challenge": {
      "$ref": "#/$defs/CanonicalCryptoCborHex"
    }
  },
  "required": [
    "accountId",
    "challenge"
  ],
  "title": "HostEnrollmentTokenContext",
  "type": "object"
}
