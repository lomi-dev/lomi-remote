{
  "format": "lomi-remote-core-scenarios",
  "version": 1,
  "description": "Core-level scenarios run through the bridge (call/free) by every compilation: native Rust (also over the C ABI on iOS and Android targets) and the WASM package. A step runs one bridge operation. 'as' stores the returned handle, 'on' uses one; 'payload' is 'hex:..', 'utf8:..' or 'vector:<name>' (a valid relay-frames vector); in an open payload '@last' is replaced by the last seal output. expect: json (deep equal), records (link record list; 'send' entries are decoded to the frame JSON), hex, or error (the error JSON). Seal output is a golden value produced by this core, not an external reference.",
  "scenarios": [
    {
      "name": "session-request",
      "steps": [
        {
          "op": "session.request",
          "args": {
            "contractHash": "ab"
          },
          "expect": {
            "json": {
              "method": "POST",
              "path": "/remote/session",
              "headers": [
                [
                  "content-type",
                  "application/json"
                ]
              ],
              "body": "{\"contractHash\":\"ab\"}"
            }
          }
        },
        {
          "op": "session.request",
          "args": {
            "contractHash": "ab",
            "refreshCredential": "rc"
          },
          "expect": {
            "json": {
              "method": "POST",
              "path": "/remote/session",
              "headers": [
                [
                  "content-type",
                  "application/json"
                ]
              ],
              "body": "{\"contractHash\":\"ab\",\"refreshCredential\":\"rc\"}"
            }
          }
        }
      ]
    },
