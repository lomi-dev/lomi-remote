                "email": "a@example.test"
              },
              "sessionExpiresAt": 1795000000000,
              "relay": {
                "token": "TTTTTTTTabcdefghijklmnopqrstuvwxyz0123456789_-",
                "expiresAt": 1794003600000
              },
              "hosts": [
                {
                  "id": "11111111-1111-4111-8111-111111111111",
