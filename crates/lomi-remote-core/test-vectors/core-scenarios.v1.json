    {
      "name": "link-reconnect-backoff",
      "steps": [
        {
          "op": "link.new",
          "as": "l",
          "args": {
            "contractHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "seed": 42
          }
        },
        {
          "op": "link.start",
          "on": "l",
          "args": {
            "token": "TTTTTTTTTTTTTTTTTTTTTTTT",
            "expiresAt": 1795000000000,
            "monoMs": 0,
            "wallMs": 1794999000000
          },
          "expect": {
            "records": [
              {
                "t": "connect"
              }
            ]
          }
        },
        {
          "op": "link.onClose",
          "on": "l",
          "args": {
            "monoMs": 100,
            "wallMs": 1794999000100
          },
          "expect": {
            "records": [
              {
                "t": "event",
                "event": {
                  "type": "disconnected",
                  "cause": "socketClosed",
                  "retryInMs": 472
                }
              }
            ]
          }
        },
        {
          "op": "link.nextDeadline",
          "on": "l",
          "expect": {
            "json": {
              "deadline": 572
            }
          }
        }
      ]
    },
