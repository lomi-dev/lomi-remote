          "op": "session.parse",
          "args": {
            "status": 200
          },
          "payload": "utf8:[]",
          "expect": {
            "error": {
              "code": "malformed"
            }
          }
        }
      ]
    },
    {
      "name": "bridge-errors",
      "steps": [
        {
          "op": "nope",
          "expect": {
            "error": {
              "code": "unknownOp"
            }
          }
        },
        {
          "op": "link.tick",
          "args": {
            "monoMs": 0,
            "wallMs": 1794999000000
          },
          "expect": {
            "error": {
              "code": "badHandle"
            }
          }
        },
        {
          "op": "directory.snapshot",
          "args": {},
          "expect": {
            "error": {
              "code": "badHandle"
            }
          }
        },
        {
          "op": "link.new",
          "args": {
            "contractHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          },
          "expect": {
            "error": {
              "code": "badArgs"
            }
          }
        },
        {
          "op": "frame.canonical",
          "args": {
            "fromRelay": true
          },
          "payload": "hex:",
          "expect": {
            "error": {
              "code": "framing"
            }
          }
        },
        {
          "op": "frame.canonical",
          "args": {
            "fromRelay": true
          },
          "payload": "hex:0300",
          "expect": {
            "error": {
              "code": "encoding"
            }
          }
        },
        {
          "op": "frame.canonical",
          "args": {
            "fromRelay": false
          },
          "payload": "vector:ready-device",
          "expect": {
            "error": {
              "code": "framing"
            }
          }
        }
      ]
    },
    {
      "name": "link-happy-path",
      "steps": [
        {
          "op": "link.new",
          "as": "l",
          "args": {
            "contractHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "seed": 42
          }
        },
        {
          "op": "link.start",
          "on": "l",
          "args": {
            "token": "TTTTTTTTTTTTTTTTTTTTTTTT",
            "expiresAt": 1795000000000,
            "monoMs": 0,
            "wallMs": 1794999000000
          },
          "expect": {
            "records": [
              {
                "t": "connect"
              }
            ]
          }
        },
        {
          "op": "link.isReady",
          "on": "l",
          "expect": {
            "json": {
              "ready": false
            }
          }
        },
        {
          "op": "link.onOpen",
          "on": "l",
          "args": {
            "monoMs": 0,
            "wallMs": 1794999000000
          },
          "expect": {
            "records": [
              {
                "t": "send",
                "frame": {
                  "type": "AUTH",
                  "role": "device",
                  "token": "TTTTTTTTTTTTTTTTTTTTTTTT",
                  "contractHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
                }
              }
            ]
          }
        },
        {
          "op": "link.onMessage",
          "on": "l",
          "args": {
            "monoMs": 5,
            "wallMs": 1794999000005
          },
          "payload": "vector:ready-device",
          "expect": {
            "records": [
              {
                "t": "event",
                "event": {
                  "type": "ready",
                  "expiresAt": 1795000000000,
                  "state": {
                    "hosts": [
                      {
                        "hostId": "11111111-1111-4111-8111-111111111111",
                        "online": true,
                        "accessEpoch": "3",
                        "runtimeGeneration": "7"
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "op": "link.isReady",
          "on": "l",
          "expect": {
            "json": {
              "ready": true
            }
          }
        },
        {
          "op": "link.onMessage",
          "on": "l",
          "args": {
            "monoMs": 10,
            "wallMs": 1794999000010
          },
          "payload": "vector:event-presence",
          "expect": {
            "records": [
              {
                "t": "event",
                "event": {
                  "type": "server",
                  "name": "presence",
                  "data": {
                    "hostId": "11111111-1111-4111-8111-111111111111",
                    "online": false,
                    "accessEpoch": "3",
                    "runtimeGeneration": "7"
                  }
                }
              }
            ]
          }
        },
        {
          "op": "link.call",
          "on": "l",
          "args": {
            "name": "circuit.open",
            "args": {
              "hostId": "11111111-1111-4111-8111-111111111111"
            },
            "monoMs": 20,
            "wallMs": 1794999000020
          },
          "expect": {
            "records": [
              {
                "t": "event",
                "event": {
                  "type": "callStarted",
                  "callId": 1
                }
              },
              {
                "t": "send",
                "frame": {
                  "type": "CALL",
                  "callId": 1,
                  "name": "circuit.open",
                  "args": {
                    "hostId": "11111111-1111-4111-8111-111111111111"
                  }
                }
              }
            ]
          }
        },
        {
          "op": "link.onMessage",
          "on": "l",
          "args": {
            "monoMs": 30,
            "wallMs": 1794999000030
          },
          "payload": "vector:reply-ok",
          "expect": {
            "records": [
              {
                "t": "event",
                "event": {
                  "type": "callDone",
                  "callId": 1,
                  "ok": {
                    "publicationSeq": "4"
                  }
                }
              }
            ]
          }
        },
        {
          "op": "link.call",
          "on": "l",
          "args": {
            "name": "token.update",
            "args": {},
            "monoMs": 31,
            "wallMs": 1794999000031
          },
          "expect": {
            "error": {
              "code": "unknownCall"
            }
          }
        },
        {
          "op": "link.stop",
          "on": "l",
          "expect": {
            "records": [
              {
                "t": "close"
              },
              {
                "t": "event",
                "event": {
                  "type": "stopped",
                  "reason": "requested",
                  "older": null
                }
              }
            ]
          }
        }
      ]
    },
