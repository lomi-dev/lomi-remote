          "payload": "utf8:{\"account\":{\"id\":\"acc-1\",\"email\":\"a@example.test\"},\"sessionExpiresAt\":1795000000000,\"relay\":{\"token\":\"TTTTTTTTabcdefghijklmnopqrstuvwxyz0123456789_-\",\"expiresAt\":1794003600000},\"hosts\":[{\"hostId\":\"11111111-1111-4111-8111-111111111111\",\"online\":true,\"accessEpoch\":\"3\",\"runtimeGeneration\":\"7\",\"workspaces\":[{\"workspaceId\":\"22222222-2222-4222-8222-222222222222\",\"workspaceEpoch\":\"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa\"}]}],\"device\":{\"state\":\"registered\",\"deviceId\":\"dev-1\"},\"futureField\":{\"ignored\":true}}",
          "expect": {
